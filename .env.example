# LLMux 环境变量配置
# 复制本文件为 .env 并填入实际值

# 管理后台 JWT 签名密钥（必填，建议至少 32 字符随机串）
JWT_SECRET=

# 凭据加密密钥（必配，32 字节 hex，如 openssl rand -hex 32；未设则首启自动生成并落盘 ./db/credential.key）
# 换密钥 = 旧密文全部不可读，须重新录入全部凭据，视作部署级永久密钥
CREDENTIAL_ENCRYPTION_KEY=

# 首启动 admin 密码（留空则首启动随机生成并打印到日志）
ADMIN_PASSWORD=

# 可信代理网段（逗号分隔 IP/CIDR，如 10.0.0.0/8,192.168.1.1）：只有这些网段内代理的
# X-Forwarded-For 会被采信为访问日志 ClientIP。留空 = 全关（直连部署默认安全，XFF 一律
# 不采信）；反代部署必须填反代网段，否则日志里 IP 恒为反代地址。非法值启动即失败。
TRUSTED_PROXIES=

# Gin 运行模式：debug / release / test
GIN_MODE=debug

# 时区
TZ=Asia/Shanghai
