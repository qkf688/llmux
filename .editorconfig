# 编辑器侧统一 LF，配合 .gitattributes，减少保存时改写换行。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,mod,sum}]
indent_style = tab

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,scss,md}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab