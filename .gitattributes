# 统一文本换行：仓库内始终 LF，避免 Windows/CRLF 假脏与跨平台 diff 噪音。
* text=auto eol=lf

# 源码与配置
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.svg    text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.env    text eol=lf
*.example text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=lf

# 二进制（禁止被当成文本做换行转换）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.db     binary
*.sqlite binary
*.zip    binary
*.gz     binary
*.tar    binary
*.exe    binary
*.dll    binary